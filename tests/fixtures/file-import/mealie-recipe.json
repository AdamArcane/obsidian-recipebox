 "recipe_instructions": [
  {
   "id": "x",
   "title": "",
   "summary": "",
   "text": "Den Backofen heizt du rechtzeitig auf 180 Grad Ober- / Unterhitze auf. Den Boden deiner Springform legst du mit Backpapier aus. Die Ränder ganz leicht mit Butter einfetten.",
   "ingredient_references": [],
   "note_references": []
  },
  {
   "id": "x",
   "title": "FÜR DEN STREUSEL-BODEN UND TOPPING",
   "summary": "",
   "text": "Für den Teig vermengst du mit dem Knethaken der Küchenmaschine oder dem Handmixer 300 g Mehl, 150 g kalte Butter und 150 g Zucker zu einer krümeligen, leicht \"sandartigen\" Masse.HINWEIS: Für das beste Streusel-Ergebnis empfehle ich dir die Verwendung einer Markenbutter / Süßrahmbutter. Bitte keine \"streichzart\"-Variante oder Margarine verwenden!",
   "ingredient_references": [],
   "note_references": []
  },
  {
   "id": "x",
   "title": "",
   "summary": "",
   "text": "Danach knetest du zügig mit der Hand die Masse grob zu Streuseln fest und gibst sie in den Kühlschrank so lange Du Dich um Deinen Belag kümmerst.",
   "ingredient_references": [],
   "note_references": []
  }
